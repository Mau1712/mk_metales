# URL canónica absoluta del sitio en producción. Sin barra final.
# Obligatoria para sitemap, og:url, canonical y Schema absolutos en el build.
# No usar localhost.
# VITE_SITE_URL=https://www.ejemplo.com

# Forzar indexación. Si no se define:
# indexable = production && VITE_SITE_URL está configurada
# VITE_INDEXABLE=true
# VITE_INDEXABLE=false

# Clave privada de Metals.Dev. Solo server-side.
# Nunca usar VITE_METALS_DEV_API_KEY.
# En Vercel: Environment Variable privada del proyecto.
METALS_DEV_API_KEY=

# Hostinger Mail API (Agentic Mail). Solo server-side, nunca VITE_.
# Token: hPanel → Emails → Agentic Mail → API access.
# HOSTINGER_MAILBOX_ID es opcional: si falta, se busca info@ en /api/v1/me.
# HOSTINGER_MAIL_API_TOKEN=
# HOSTINGER_MAILBOX_ID=
# CONTACT_TO_EMAIL=info@mkmetales.com
# HOSTINGER_MAIL_FROM=info@mkmetales.com
