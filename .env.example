# URL canónica absoluta del sitio en producción. Sin barra final.
# Obligatoria para sitemap, og:url, canonical y Schema absolutos en el build.
# No usar localhost.
# VITE_SITE_URL=https://www.ejemplo.com

# Forzar indexación. Si no se define:
# indexable = production && VITE_SITE_URL está configurada
# VITE_INDEXABLE=true
# VITE_INDEXABLE=false
